@page
@model RazorBoatApp2026InClass.Pages.Members.LoginModel
@{
    ViewData["Title"] = "Login";
}

<h1>Login</h1>
@Model.Message
<form method="post">
    <table>
        <tr>
            <td>PhoneNumber</td>
            <td><Input type="text" asp-for="@Model.PhoneNumber" /></td>
        </tr>
        <tr>
            <td>Password</td>
            <td><Input type="password" asp-for="@Model.Password" /></td>
        </tr>
        <tr>
            <td>&nbsp</td>
            <td><Input type="submit" value="Login" /></td>
        </tr>
    </table>
    <a asp-page="CreateMember">Opret ny bruger</a>
</form>

